nano /etc/nginx/sites-available/fleet-backend.tt64295.tw1.ru

server {
    listen 80;
    server_name fleet-backend.tt64295.tw1.ru;

    location / {
        proxy_pass http://localhost:8088;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Agar CORS kerak bo‘lsa:
        add_header 'Access-Control-Allow-Origin' 'https://fleet.tt64295.tw1.ru' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS, PUT, DELETE' always;
        add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type' always;

        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Max-Age' 1728000;
            add_header 'Content-Type' 'text/plain; charset=utf-8';
            add_header 'Content-Length' 0;
            return 204;
        }
    }
}

sudo ln -s /etc/nginx/sites-available/fleet-backend.tt64295.tw1.ru /etc/nginx/sites-enabled/

sudo apt install certbot python3-certbot-nginx
sudo certbot --nginx -d fleet-backend.tt64295.tw1.ru -d www.fleet-backend.tt64295.tw1.ru







